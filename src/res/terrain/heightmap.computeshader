	#version 430 core

// Inputs
layout(local_size_x = 16, local_size_y = 16) in;

uniform ivec2 u_RegionOrigin;
uniform ivec2 u_RegionSize;
uniform int u_Permutation[512];
uniform float u_HeightTexelSize;

// Outputs
layout(r32f, binding = 0) uniform writeonly image2D u_HeightImage;

// -------------------------------------------------------------------------------------------------------------
// Perlin Noise
// -------------------------------------------------------------------------------------------------------------

vec2 getConstantVector(int permutationValue) {
	int h = permutationValue & 3;
	switch(h) {
		case 0:  return vec2( 1.0,  1.0);
		case 1:  return vec2(-1.0,  1.0);
		case 2:  return vec2(-1.0, -1.0);
		default: return vec2( 1.0, -1.0);
	}
}

float perlin2D (float x, float y){
	int X = int(floor(x)) & 255;
	int Y = int(floor(y)) & 255;

	float xf = x-floor(x);
	float yf = y-floor(y);

	vec2 topRight    = vec2(xf - 1.0, yf - 1.0);
	vec2 topLeft     = vec2(xf,       yf - 1.0);
	vec2 bottomRight = vec2(xf - 1.0, yf      );
	vec2 bottomLeft  = vec2(xf,       yf      );

	int valueTopRight    = u_Permutation[u_Permutation[X+1] + Y+1];
	int valueTopLeft     = u_Permutation[u_Permutation[X  ] + Y+1];
	int valueBottomRight = u_Permutation[u_Permutation[X+1] + Y  ];
	int valueBottomLeft  = u_Permutation[u_Permutation[X  ] + Y  ];

	float dotTopRight    = dot(topRight,    getConstantVector(valueTopRight));
	float dotTopLeft     = dot(topLeft,     getConstantVector(valueTopLeft));
	float dotBottomRight = dot(bottomRight, getConstantVector(valueBottomRight));
	float dotBottomLeft  = dot(bottomLeft,  getConstantVector(valueBottomLeft));

	float u = xf * xf * xf * (xf * (xf * 6 - 15) + 10);
	float v = yf * yf * yf * (yf * (yf * 6 - 15) + 10);

	return mix(mix(dotBottomLeft, dotTopLeft, v),
				mix(dotBottomRight, dotTopRight, v),
				u);
}

// -------------------------------------------------------------------------------------------------------------
// Fractal brownian motion
// -------------------------------------------------------------------------------------------------------------

const int octaves = 4;
const float gain = 0.34;
const float lacunarity  = 2.5;
const mat2 m2 = mat2(0.8, -0.6, 0.6, 0.8);

float fbm(vec2 p)
{
	float f = 0.0;
	float a = 0.5;

	for (int i = 0; i < octaves; ++i)
	{
		f += a * perlin2D(p.x, p.y);
		a *= gain;
		p = m2 * p * lacunarity;
	}

	return f;
}

const float terrainAmp  = 12.9;
const float terrainFreq = 0.048;

float noisedHeight(vec2 p)
{
	return terrainAmp * fbm(p * terrainFreq);
}

// -------------------------------------------------------------------------------------------------------------
// Main
// -------------------------------------------------------------------------------------------------------------

const float groundY = 0.0;

void main()
{
	ivec2 id = ivec2(gl_GlobalInvocationID.xy);
	if (any(greaterThanEqual(id, u_RegionSize)))
		return;

	ivec2 worldTexel = u_RegionOrigin + id;
	vec2 xz = (vec2(worldTexel) + 0.5) * u_HeightTexelSize;
	
	imageStore(u_HeightImage, worldTexel & (imageSize(u_HeightImage) - 1), vec4(groundY + noisedHeight(xz)));
}
