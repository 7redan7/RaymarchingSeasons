#version 430 core

// Inputs
layout(quads, equal_spacing, ccw) in;

uniform mat4 u_MVP;
layout(binding = 3) uniform sampler2D u_Heightmap;
uniform float u_HeightTexelSize;
uniform float u_HeightmapWorldSize;

// Outputs
out vec3 fragmentNormal;

// -------------------------------------------------------------------------------------------------------------
// Terrain
// -------------------------------------------------------------------------------------------------------------


float terrainHeightAt(vec2 xz)
{
	return textureLod(u_Heightmap, xz / u_HeightmapWorldSize, 0.0).r;
}

vec3 terrainNormal(vec2 p)
{
	float normalEps = u_HeightTexelSize;
	float heightLeft = terrainHeightAt(p - vec2(normalEps, 0.0));
	float heightRight = terrainHeightAt(p + vec2(normalEps, 0.0));
	float heightDown = terrainHeightAt(p - vec2(0.0, normalEps));
	float heightUp = terrainHeightAt(p + vec2(0.0, normalEps));

	return normalize(vec3(heightLeft - heightRight, 2.0 * normalEps, heightDown - heightUp));
}

// -------------------------------------------------------------------------------------------------------------
// Main
// -------------------------------------------------------------------------------------------------------------

void main()
{
	float u = gl_TessCoord.x;
	float v = gl_TessCoord.y;

	vec4 p0 = mix(gl_in[0].gl_Position, gl_in[1].gl_Position, u);
	vec4 p1 = mix(gl_in[3].gl_Position, gl_in[2].gl_Position, u);
	vec4 position = mix(p0, p1, v);

	position.y = terrainHeightAt(position.xz);
	fragmentNormal = terrainNormal(position.xz);

	gl_Position = u_MVP * position;
}