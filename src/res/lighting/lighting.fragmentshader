#version 430 core

// Inputs
uniform mat4 u_InvVP;
uniform vec3 u_CamPos;
uniform vec2 u_Resolution;
uniform vec2 u_RegionCenter;

layout(binding = 3) uniform sampler2D u_Heightmap;
uniform float u_HeightTexelSize;
uniform float u_HeightmapWorldSize;

uniform sampler2D u_Normal;
uniform sampler2D u_Albedo;
uniform sampler2D u_Depth;

// Outputs
out vec3 color;

// -------------------------------------------------------------------------------------------------------------
// Terrain
// -------------------------------------------------------------------------------------------------------------

float fbmMaxValue()
{
	const int octaves = 4;
	const float gain = 0.34;
	float a = 0.5;
	float s = 0.0;

	for (int i = 0; i < octaves; i++)
	{
		s += a;
		a *= gain;
	}

	return s;
}

float terrainHeightAt(vec2 xz)
{
	return textureLod(u_Heightmap, xz / u_HeightmapWorldSize, 0.0).r;
}

// -------------------------------------------------------------------------------------------------------------
// SDFs
// -------------------------------------------------------------------------------------------------------------

float sdEllipsoid(vec3 p, vec2 r)
{
	float k0 = length(p / r.xyx);
	float k1 = length(p / (r.xyx * r.xyx));
	return k0 * (k0 - 1.0) / k1;
}

float sdBoundingRegion(vec3 p)
{
	float heightRegionHalfSize = 0.5 * u_HeightmapWorldSize - 2.0 * u_HeightTexelSize;
	vec2 q = abs(p.xz - u_RegionCenter) - heightRegionHalfSize;
	return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0);
}

// -------------------------------------------------------------------------------------------------------------
// Scene
// -------------------------------------------------------------------------------------------------------------

vec2 TreeHash(vec2 p)
{
	const vec2 k = vec2(0.3183099, 0.3678794);
	float n = 111.0 * p.x + 113.0 * p.y;
	return fract(n * fract(k * n));
}

const float sceneScale = 0.1;
const float tileSize = 2.0;
const float baseTreeHeight = 4.8;

float map(vec3 p, float terrainHeight)
{
	vec3 pMeters = vec3(p.x, p.y - terrainHeight, p.z) / sceneScale;
	float closestTreeDist = 10000.0;
	vec2 tileIndex = floor(pMeters.xz / tileSize);
	vec2 tileOffset = fract(pMeters.xz / tileSize);
	for (int j = 0; j <= 1; j++)
	for (int i = 0; i <= 1; i++)
	{

		vec2 currentNeighbor = vec2(float(i), float(j)) - step(tileOffset, vec2(0.5));


		vec2 treeCenter = TreeHash(tileIndex + currentNeighbor);
		vec2 treeSize = TreeHash(tileIndex + currentNeighbor + vec2(13.1, 71.7));

		vec2 d = (currentNeighbor - tileOffset + treeCenter);
		float treeHeight = baseTreeHeight * (0.4 + 0.8 * treeSize.x);
		float treeWidth = 0.5;

		vec3 pLocal = vec3(d.x, pMeters.y - 0.5 * treeHeight, d.y);
		closestTreeDist = min(closestTreeDist, sdEllipsoid(pLocal, vec2(treeWidth, 0.5 * treeHeight)));
	}
	return max(closestTreeDist * sceneScale, sdBoundingRegion(p));
}

// -------------------------------------------------------------------------------------------------------------
// Raymarch Shadows
// -------------------------------------------------------------------------------------------------------------

const float groundY = 0.0;
const float terrainAmp = 12.9;
const int shadowSteps = 128;
const float shadowMinStep = 0.005;
const float shadowMaxStep = 0.3;
const float shadowTerrainStep = 0.5;
const float shadowSoftness = 4.00;

float raymarchShadow(vec3 ro, vec3 rd, float tStart)
{

	float treesTop = groundY + terrainAmp * fbmMaxValue() + 1.2 * baseTreeHeight * sceneScale;

	float res = 1.0;
	float t = tStart;
	for (int i = 0; i < shadowSteps; i++)
	{
		vec3 p = ro + rd * t;
			if (p.y > treesTop || sdBoundingRegion(p) > 0.0)
			break;

		float terrainHeight = terrainHeightAt(p.xz);
		float h = p.y - terrainHeight;
		if (h < 0.0)
			return 0.0;

		float d = map(p, terrainHeight);
		res = min(res, shadowSoftness * min(d, h) / t);
		if (res < 0.001)
			return 0.0;

			t += clamp(d, shadowMinStep, max(shadowMaxStep, shadowTerrainStep * h));
	}
	return clamp(res, 0.0, 1.0);
}

// -------------------------------------------------------------------------------------------------------------
// Sky
// -------------------------------------------------------------------------------------------------------------

const vec3 skyHorizonColor = vec3(0.65, 0.75, 0.85);
const vec3 skyZenithColor = vec3(0.15, 0.35, 0.65);

vec3 skyGradient(vec3 viewDir)
{
	float skyHeight = clamp(viewDir.y, 0.0, 1.0);
	float skyBlend = 1.0 - pow(1.0 - skyHeight, 4.0);
	return mix(skyHorizonColor, skyZenithColor, skyBlend);
}

const float sunAzimuth = 20.0;
const float sunElevation = 16.0;
const vec3 sunDir = vec3(cos(radians(sunElevation)) * cos(radians(sunAzimuth)), 
							sin(radians(sunElevation)), 
							cos(radians(sunElevation)) * sin(radians(sunAzimuth)));
const vec3 sunlightColor = mix(vec3(1.0), vec3(1.0, 0.8, 0.4), 0.25);

const float ambientImpactCoefficient = 1.00;
const float diffuseImpactCoefficient = 1.30;
const float shadowImpactOnAmbient = 0.40;
const float bounceStrength = 0.10;

const vec3 fogMultiplier = vec3(1.0, 2.0, 2.0);
const float fogDensity = 0.001;

void main()
{
	ivec2 pixel = ivec2(gl_FragCoord.xy);
	float depth = texelFetch(u_Depth, pixel, 0).r;
	if (depth == 1.0)
		discard;

	vec3 normal = normalize(texelFetch(u_Normal, pixel, 0).xyz);
	vec4 albedo = texelFetch(u_Albedo, pixel, 0);
	vec3 materialColor = pow(albedo.rgb, vec3(2.2));

	vec2 ndc = (gl_FragCoord.xy / u_Resolution) * 2.0 - 1.0;
	vec4 posClip = vec4(ndc, depth * 2.0 - 1.0, 1.0);
	vec4 world = u_InvVP * posClip;
	world /= world.w;
	vec3 pos = world.xyz;

	if (albedo.a < 0.1)
		pos.y = terrainHeightAt(pos.xz);

	float distanceToCamera = length(pos - u_CamPos);

	const vec3 skyAmbient = vec3(0.24, 0.26, 0.32);
	const vec3 groundAmbient = vec3(0.10, 0.09, 0.07);
	vec3 ambient = mix(groundAmbient, skyAmbient, normal.y * 0.5 + 0.5);
	vec3 lightDir = normalize(sunDir);
	float diffuse = max(dot(normal, lightDir), 0.0);

	// Bounce light
	vec3 bounceDir = vec3(-lightDir.x, 0.0, -lightDir.z);
	float bounceLength = length(bounceDir);
	bounceDir /= max(bounceLength, 0.0001);
	vec3 bounceLight = materialColor * max(dot(normal, bounceDir), 0.0) * bounceStrength;

	// Shadow Raymarching
	float shadow = 1.0;
	float shadowBias = 0.002 + 0.0003 * length(pos - u_CamPos);
	shadow = raymarchShadow(pos + normal * shadowBias, lightDir, shadowBias);

	color = materialColor * (ambient * ambientImpactCoefficient * mix(1.0, shadow, shadowImpactOnAmbient)
							+ diffuse * diffuseImpactCoefficient * sunlightColor * shadow
							+ bounceLight);

	// Foschia
	vec3 fogAmount = 1.0 - exp(-fogDensity * distanceToCamera * fogMultiplier);
	vec3 fogColor = pow(skyHorizonColor, vec3(2.2));
	color = mix(color, fogColor, fogAmount);
	color = pow(max(color, vec3(0.0)), vec3(1.0 / 2.2));
}
